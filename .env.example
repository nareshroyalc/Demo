GEMINI_API_KEY=your_key_here
# Optional overrides
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# MCP_TOKEN=change-me   # if set, /mcp requires "Authorization: Bearer <token>"
# Hosted deployment (Render generates these for you via render.yaml)
# MCP_TOKEN=long-random-string      # required Bearer token for /mcp
# APP_PASSWORD=another-random-string # HTTP Basic password for the UI, /agent and /api
# AGENT_RATE_PER_MIN=8
# PROMPT_CACHE=auto            # auto (default) or off
# PROMPT_CACHE_TTL_SECONDS=3600
